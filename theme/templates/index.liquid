{%- assign pele = collections['pele'] -%}
{%- assign hero = pele.products.first -%}
<div class="wrap">
  {%- if pele and pele.products_count > 0 -%}
  <div class="hcar r in" id="hcar">
    <div class="hstage" id="hstage">
      {%- for product in pele.products limit: 10 -%}
      {%- assign img = product.featured_image -%}
      {%- if img -%}
      <div class="hslide{% if forloop.first %} on{% endif %}"
           data-artist="{{ product.vendor | escape }}" data-title="{{ product.title | escape }}">
        <a class="hcar-work" href="{{ product.url | within: pele }}" draggable="false">
          <img src="{{ img | image_url: width: 1800 }}"
            srcset="{{ img | image_url: width: 1800 }} 1x, {{ img | image_url: width: 2800 }} 2x"
            sizes="92vw" width="{{ img.width }}" height="{{ img.height }}"
            alt="{{ product.title | escape }}" loading="eager" draggable="false"
            {% if forloop.first %}fetchpriority="high"{% endif %}
            decoding="async" onload="this.classList.add('ld')">
        </a>
      </div>
      {%- endif -%}
      {%- endfor -%}
      <button class="hcar-zone l" aria-label="Previous work"></button>
      <button class="hcar-zone r" aria-label="Next work"></button>
    </div>
    <div class="hline"><span id="hline-fill"></span></div>
    <div class="hero-cap" id="hcar-cap">
      <span class="t"><span id="hc-artist">{{ pele.products.first.vendor }}</span> · <span id="hc-title">{{ pele.products.first.title }}</span></span>
      <span class="s"><span id="hcar-pos">01</span> / {{ pele.products_count | at_most: 10 | prepend: '00' | slice: -2, 2 }} &nbsp;·&nbsp; <a class="hcar-link" href="{{ pele.url }}">VIEW THE COLLECTION</a></span>
    </div>
  </div>
{%- endif -%}
  <section class="ink" id="ink">
    <div class="ink-k">CHASE CONTEMPORARY</div>
    <h2 class="ink-h">A CONSIDERED COLLECTION</h2>
    <p class="ink-p" id="inkp">We bring together extraordinary works from some of the most compelling artists of our time, photography, painting, and mixed media selected for their artistic integrity, cultural resonance, and the stories they carry. Every piece in the collection is chosen because it endures.</p>
  </section>
  <div class="section-label r">SELECTED WORKS</div>
  </div><!-- /wrap: corridor runs full-bleed -->
  <div class="fcanvas r in" id="fcanvas">
    <div class="fc-track" id="fc-track">
      {%- assign shown = 0 -%}
      {%- for product in collections.all.products limit: 90 -%}
        {%- assign img = product.featured_image -%}
        {%- if img and img.width >= 1600 and img.height >= 1200 and product.type != 'Print' and shown < 24 -%}
        <div class="fc-item">
          <a href="{{ product.url }}" draggable="false">
            <img src="{{ img | image_url: width: 1100 }}"
              srcset="{{ img | image_url: width: 1100 }} 1x, {{ img | image_url: width: 2048 }} 2x"
              sizes="44vw" width="{{ img.width }}" height="{{ img.height }}"
              alt="{{ product.title | escape }}" loading="lazy" decoding="async" draggable="false"
              onload="this.classList.add('ld')">
            <div class="fc-cap"><span class="a">{{ product.vendor }}</span><span class="t">{{ product.title }}</span></div>
          </a>
        </div>
        {%- assign shown = shown | plus: 1 -%}
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
  <div class="wrap">
  <div class="section-label r">ARTISTS</div>
  <ul class="index-list r">
    {%- for c in collections -%}
      {%- unless c.handle == 'pele' or c.handle == 'summer-sale' or c.handle == 'all' or c.handle == 'frontpage' -%}
      <li><a href="{{ c.url }}" data-img="{{ c.products.first.featured_image | image_url: width: 640 }}">
        <span class="n">{{ c.title }}</span><span class="c">{{ c.products_count }} WORKS</span></a></li>
      {%- endunless -%}
    {%- endfor -%}
  </ul>
</div>