{%- assign pele = collections['pele'] -%}
{%- assign hero = pele.products.first -%}
<div class="wrap">
  {%- if hero and hero.featured_image -%}
  <a class="hero r in" href="{{ pele.url }}">
    <img class="fx" src="{{ hero.featured_image | image_url: width: 2400 }}" alt="{{ pele.title | escape }}"
      width="{{ hero.featured_image.width }}" height="{{ hero.featured_image.height }}"
      decoding="async" fetchpriority="high" onload="this.classList.add('ld')">
  </a>
  <div class="hero-cap"><span class="t">{{ pele.title }} · A COLLECTION</span><span class="s">CURRENT EXHIBITION</span></div>
  {%- endif -%}
  <div class="statement r">HAND-SIGNED ORIGINALS · LIMITED EDITION WORKS · AUTHENTICATED ART</div>
  <div class="section-label r">SELECTED WORKS</div>
  <div class="feat">
    {%- assign shown = 0 -%}
    {%- assign classes = 'f-a,f-b,f-c,f-d,f-e,f-f' | split: ',' -%}
    {%- for product in collections.all.products limit: 24 -%}
      {%- if product.featured_image and product.type != 'Print' and shown < 6 -%}
        <div class="{{ classes[shown] }}">{% render 'card', card_product: product %}</div>
        {%- assign shown = shown | plus: 1 -%}
      {%- endif -%}
    {%- endfor -%}
  </div>
  <div class="section-label r">ARTISTS</div>
  <ul class="index-list r">
    {%- for c in collections -%}
      {%- unless c.handle == 'pele' or c.handle == 'summer-sale' or c.handle == 'all' or c.handle == 'frontpage' -%}
      <li><a href="{{ c.url }}" data-img="{{ c.products.first.featured_image | image_url: width: 640 }}">
        <span class="n">{{ c.title }}</span><span class="c">{{ c.products_count }} WORKS</span></a></li>
      {%- endunless -%}
    {%- endfor -%}
  </ul>
</div>