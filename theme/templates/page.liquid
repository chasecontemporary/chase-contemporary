{%- case page.handle -%}
{%- when 'about' -%}{% render 'page-about' %}
{%- when 'contact' -%}{% render 'page-contact' %}
{%- when 'press' -%}{% render 'page-press' %}
{%- when 'exhibitions' -%}{% render 'page-exhibitions' %}
{%- when 'delivery-returns' -%}{% render 'page-delivery-returns' %}
{%- when 'payment-finance' -%}{% render 'page-payment-finance' %}
{%- else -%}
<div class="wrap">
  <div class="page-title r in">{{ page.title | upcase }}</div>
  <div class="section-label"></div>
  <div class="prose r in">{{ page.content }}</div>
</div>
{%- endcase -%}