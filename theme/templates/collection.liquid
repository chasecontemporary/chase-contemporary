{%- if collection.handle == 'pele' -%}
<div class="exh" id="exh" tabindex="0" aria-label="{{ collection.title | escape }} exhibition">
  {%- for product in collection.products -%}
  {%- assign img = product.featured_image -%}
  <section class="exh-slide">
    <a class="exh-work" href="{{ product.url | within: collection }}">
      {%- if img -%}
      <img src="{{ img | image_url: width: 1400 }}"
        srcset="{{ img | image_url: width: 1400 }} 1x, {{ img | image_url: width: 2400 }} 2x"
        sizes="78vw" width="{{ img.width }}" height="{{ img.height }}"
        alt="{{ product.title | escape }}" loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
        decoding="async" onload="this.classList.add('ld')">
      {%- endif -%}
    </a>
    <div class="exh-cap">
      <div class="artist">{{ product.vendor }}</div>
      <div class="title">{{ product.title }}</div>
      <div class="price">{% if product.type == 'Print' and product.price > 0 %}{{ product.price | money_without_trailing_zeros }}{% else %}Price on request{% endif %}</div>
      <a class="go" href="{{ product.url | within: collection }}#inquire">INQUIRE</a>
    </div>
  </section>
  {%- endfor -%}
</div>
<button class="exh-arrow l" aria-label="Previous work">&#8249;</button>
<button class="exh-arrow r" aria-label="Next work">&#8250;</button>
<div class="exh-idx"><span id="exh-pos">01</span> / {{ collection.products_count | prepend: '00' | slice: -2, 2 }}</div>
{%- else -%}
<div class="wrap">
  <div class="page-title r in">{{ collection.title }}</div>
  <div class="page-sub r in">{{ collection.products_count }} WORKS{% if collection.handle == 'pele' %} · CURRENT EXHIBITION{% endif %}</div>
  <div class="section-label"></div>
  <div class="grid">
    {%- paginate collection.products by 50 -%}
      {%- for product in collection.products -%}
        {% render 'card', card_product: product, card_collection: collection, card_num: forloop.index %}
      {%- endfor -%}
    {%- endpaginate -%}
  </div>
</div>
{%- endif -%}