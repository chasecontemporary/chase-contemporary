{
  "display_information": {
    "name": "Chase Engine",
    "description": "Sales floor alerts from the Chase Engine",
    "background_color": "#000000"
  },
  "features": {
    "bot_user": {
      "display_name": "Chase Engine",
      "always_online": true
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": ["incoming-webhook", "chat:write", "chat:write.public"]
    }
  },
  "settings": {
    "interactivity": {
      "is_enabled": true,
      "request_url": "https://chase-engine.vercel.app/api/slack/action"
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": false,
    "token_rotation_enabled": false
  }
}
